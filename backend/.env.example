# AK DeviceLock Backend Environment Configuration
# Copy to .env (dev/staging) or /etc/akdl/akdl.env (production)

AKDL_ENV=development
AKDL_DEBUG=1
# Required in production (AKDL_DEBUG=0), >= 32 random chars
AKDL_SECRET_KEY=replace-with-strong-random-64-char-secret
AKDL_ALLOWED_HOSTS=127.0.0.1,localhost
AKDL_CSRF_ORIGINS=http://127.0.0.1:8000,http://localhost:5173

# PostgreSQL (leave AKDL_DB_NAME blank to use SQLite in local dev)
AKDL_DB_NAME=
AKDL_DB_USER=
AKDL_DB_PASSWORD=
AKDL_DB_HOST=127.0.0.1
AKDL_DB_PORT=5432

# JWT lifetimes & rate limits
AKDL_JWT_ACCESS_MINUTES=15
AKDL_JWT_REFRESH_DAYS=7
AKDL_LOGIN_RATE=10/min
AKDL_REFRESH_RATE=30/min

# Enrollment & Provisioning
AKDL_ENROLLMENT_KEY=replace-with-strong-enrollment-key
AKDL_PUBLIC_BASE_URL=http://127.0.0.1:8000
AKDL_APK_PATH=/etc/akdl/akdevicelock.apk
AKDL_APK_CERT_SHA256=
AKDL_KEY_STORAGE_DIR=/etc/akdl/keys
AKDL_SIGNING_KEY_PATH=/etc/akdl/command_signing_key.pem
AKDL_DATA_ENCRYPTION_KEY=

# HTTPS (set AKDL_SSL_REDIRECT=1 behind TLS proxy in production)
AKDL_SSL_REDIRECT=0
