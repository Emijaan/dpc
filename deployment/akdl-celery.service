[Unit]
Description=AK DeviceLock Celery Worker & Beat
After=network.target redis-server.service postgresql.service

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/opt/akdevicelock/backend
EnvironmentFile=/etc/akdl/akdl.env
ExecStart=/opt/akdevicelock/backend/.venv/bin/celery -A akdl worker -B --loglevel=INFO
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
