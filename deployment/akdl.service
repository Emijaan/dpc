[Unit]
Description=AK DeviceLock Django Backend (Gunicorn)
After=network.target postgresql.service

[Service]
Type=simple
User=ubuntu
Group=www-data
WorkingDirectory=/opt/akdevicelock/backend
EnvironmentFile=/etc/akdl/akdl.env
ExecStart=/opt/akdevicelock/backend/.venv/bin/gunicorn akdl.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 60 --access-logfile - --error-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

